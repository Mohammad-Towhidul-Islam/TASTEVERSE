# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/tasteverse?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
ADMIN_EMAIL="admin@tasteverse.local"
ADMIN_PASSWORD="ChangeThisAdminPassword123!"

# SSLCommerz sandbox credentials. Get merchant credentials from SSLCommerz.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"

# Optional email (SMTP). If empty, app logs dev email notice instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="TASTEVERSE <orders@example.com>"
